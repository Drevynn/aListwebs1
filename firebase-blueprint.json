{
  "entities": {
    "Site": {
      "title": "Site",
      "description": "A website project",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "design_summary": { "type": "string" },
        "status": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["user_id", "design_summary", "status"]
    },
    "User": {
      "title": "User",
      "description": "User profile",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" },
        "hasMailAccess": { "type": "boolean" },
        "subscriptionTier": { "type": "string" },
        "subscriptionStatus": { "type": "string" },
        "stripeCustomerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "User billing and subscription status",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "user_email": { "type": "string", "format": "email" },
        "tier": { "type": "string" },
        "status": { "type": "string" },
        "stripeSubscriptionId": { "type": "string" },
        "stripeCustomerId": { "type": "string" },
        "currentPeriodEnd": { "type": "string" },
        "domainUpsell": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "tier", "status"]
    },
    "Contact": {
      "title": "Contact",
      "description": "Mailing list contact",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "user_id": { "type": "string" },
        "site_id": { "type": "string" }
      },
      "required": ["email", "user_id", "site_id"]
    },
    "Email": {
      "title": "Email",
      "description": "Sent email log",
      "type": "object",
      "properties": {
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "recipient": { "type": "string" },
        "user_id": { "type": "string" },
        "site_id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subject", "body", "recipient", "user_id", "site_id"]
    },
    "CloudConnection": {
      "title": "CloudConnection",
      "description": "Linked Google Drive or Dropbox account",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "provider": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "accessToken": { "type": "string" },
        "refreshToken": { "type": "string" },
        "connectedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "provider", "email", "connectedAt"]
    },
    "SyncConfig": {
      "title": "SyncConfig",
      "description": "Directory sync configuration",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "provider": { "type": "string" },
        "folderId": { "type": "string" },
        "folderName": { "type": "string" },
        "lastSynced": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "provider", "folderId", "folderName"]
    },
    "EPK": {
      "title": "EPK",
      "description": "Electronic Press Kit",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "bandName": { "type": "string" },
        "bio": { "type": "string" },
        "mediaUrls": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "bandName"]
    },
    "InboxMessage": {
      "title": "InboxMessage",
      "description": "Band contact message",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "senderEmail": { "type": "string", "format": "email" },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "senderEmail", "subject", "body"]
    },
    "Product": {
      "title": "Product",
      "description": "Store digital or physical product configured with Stripe",
      "type": "object",
      "properties": {
        "stripeProductId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "tax_code": { "type": "string" },
        "priceId": { "type": "string" },
        "unit_amount": { "type": "number" },
        "currency": { "type": "string" },
        "user_id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["stripeProductId", "name", "tax_code"]
    },
    "Order": {
      "title": "Order",
      "description": "Stripe checkout completed payment record",
      "type": "object",
      "properties": {
        "stripeSessionId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerEmail": { "type": "string", "format": "email" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "productId": { "type": "string" },
        "user_id": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["stripeSessionId", "amount", "currency", "status"]
    },
    "Mailbox": {
      "title": "Mailbox",
      "description": "Domain-linked custom email address mailbox for sending and receiving",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "domain": { "type": "string" },
        "emailAddress": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "quotaMb": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "domain", "emailAddress", "status"]
    },
    "MailMessage": {
      "title": "MailMessage",
      "description": "Received or sent email item in a sovereign domain mailbox",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "mailbox_id": { "type": "string" },
        "domain": { "type": "string" },
        "folder": { "type": "string" },
        "from": { "type": "string" },
        "fromName": { "type": "string" },
        "to": { "type": "string" },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "isRead": { "type": "boolean" },
        "isStarred": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "folder", "from", "to", "subject", "body"]
    },
    "CMSContent": {
      "title": "CMSContent",
      "description": "User created articles, announcements, releases, and press items",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "summary": { "type": "string" },
        "body": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "title", "type", "status"]
    },
    "DesignPartner": {
      "title": "DesignPartner",
      "description": "Founding cohort design partner application",
      "type": "object",
      "properties": {
        "bandName": { "type": "string" },
        "discipline": { "type": "string" },
        "links": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "frustrations": { "type": "string" },
        "source": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["bandName", "email"]
    },
    "Portfolio": {
      "title": "Portfolio",
      "description": "Artist portfolio, showreels, headshots, and credentials",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "artistName": { "type": "string" },
        "headline": { "type": "string" },
        "bio": { "type": "string" },
        "discipline": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id"]
    },
    "SiteDocument": {
      "title": "SiteDocument",
      "description": "Google Doc linked to a user site",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "site_id": { "type": "string" },
        "document_id": { "type": "string" },
        "title": { "type": "string" },
        "doc_type": { "type": "string" },
        "google_doc_url": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "site_id", "document_id", "title"]
    },
    "TalentVerification": {
      "title": "TalentVerification",
      "description": "Union credential and professional profile verification request",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "talentName": { "type": "string" },
        "legalName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "discipline": { "type": "string" },
        "filmDepartment": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "submissionDate": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "talentName", "status"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Digital products with tax codes"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Completed customer orders and payments"
    },
    "/sites/{siteId}": {
      "schema": "Site",
      "description": "User websites"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "User subscription records and billing status"
    },
    "/contacts/{contactId}": {
      "schema": "Contact",
      "description": "Mailing list contacts"
    },
    "/emails/{emailId}": {
      "schema": "Email",
      "description": "Sent email log"
    },
    "/mailboxes/{mailboxId}": {
      "schema": "Mailbox",
      "description": "User domain mailboxes"
    },
    "/mail_messages/{messageId}": {
      "schema": "MailMessage",
      "description": "Inbound and outbound email messages"
    },
    "/cloud_connections/{connectionId}": {
      "schema": "CloudConnection",
      "description": "Linked cloud accounts"
    },
    "/epks/{epkId}": {
      "schema": "EPK",
      "description": "Musician EPKs"
    },
    "/inbox_messages/{messageId}": {
      "schema": "InboxMessage",
      "description": "Booking and contact messages"
    },
    "/sync_configs/{syncId}": {
      "schema": "SyncConfig",
      "description": "Directory sync configurations"
    },
    "/cms_content/{contentId}": {
      "schema": "CMSContent",
      "description": "CMS published and draft content items"
    },
    "/design_partners/{partnerId}": {
      "schema": "DesignPartner",
      "description": "Design partner applications for founding cohort"
    },
    "/portfolios/{portfolioId}": {
      "schema": "Portfolio",
      "description": "Artist portfolios and showreel hubs"
    },
    "/site_documents/{docId}": {
      "schema": "SiteDocument",
      "description": "Site Google Docs records"
    },
    "/talent_verifications/{verificationId}": {
      "schema": "TalentVerification",
      "description": "Talent union and professional link verification requests"
    }
  }
}

