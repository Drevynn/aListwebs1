rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email == 'dev@alistwebs.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function hasMailAccess() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hasMailAccess == true;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /sites/{siteId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /contacts/{contactId} {
      allow read, write: if hasMailAccess() && resource.data.user_id == request.auth.uid;
    }

    match /emails/{emailId} {
      allow read, write: if hasMailAccess() && resource.data.user_id == request.auth.uid;
    }

    match /cloud_connections/{connectionId} {
      allow read, delete: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
    }

    match /epks/{epkId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
    }

    match /inbox_messages/{messageId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
    }

    match /sync_configs/{syncId} {
      allow read, write: if isSignedIn() && request.auth.uid == resource.data.user_id;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if true;
    }

    match /site_documents/{docId} {
      allow read, delete: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }
  }
}
